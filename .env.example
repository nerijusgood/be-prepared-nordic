# Copy to .env for local testing (never commit .env). In Vercel, add these under Settings > Environment Variables.
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXXXX/exec
SHEET_SECRET=put-a-long-random-secret-here
# Optional: allow other origins (comma separated). Default is same host only.
# ALLOWED_ORIGINS=https://your-domain.example
